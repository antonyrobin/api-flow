{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@api-flow/api",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@api-flow/web",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@api-flow/web",
        "exec",
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    }
  ]
}