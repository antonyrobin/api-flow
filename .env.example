# ============================================
# API Flow — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --------------------------------------------
# Better Auth
# --------------------------------------------
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:8787

# --------------------------------------------
# Google OAuth
# --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------
# Apple OAuth
# --------------------------------------------
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --------------------------------------------
# Email via Resend (verification, password reset, welcome)
# Worker secrets: wrangler secret put RESEND_API_KEY / EMAIL_FROM
# --------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="API Flow <noreply@yourdomain.com>"

# --------------------------------------------
# Cloudflare (set in wrangler.jsonc or dashboard)
# --------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# --------------------------------------------
# App
# --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3100
