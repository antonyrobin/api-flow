# Public build-time settings for the production web app (committed on purpose).
# These URLs are not secrets — they end up in the shipped JavaScript anyway.
# Cloudflare Pages Git builds read this file; a Pages environment variable with
# the same name, or apps/web/.env.production.local, overrides it.
NEXT_PUBLIC_API_URL=https://apiflowrest.redexoans.com
NEXT_PUBLIC_APP_URL=https://apiflow.redexoans.com
