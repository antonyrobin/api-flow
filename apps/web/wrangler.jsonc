{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker serving the Next.js static export (out/).
  // Name must match the Worker connected to Git in the dashboard (Workers Builds).
  "name": "api-flow-web",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./out",
    // /login -> login.html, unknown paths -> out/404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
