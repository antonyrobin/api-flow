{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "api-flow-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // D1 Database binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "api-flow-db",
      "database_id": "537824d2-b6b0-44fa-84ce-c5dbc1b3e57a",
      // Migrations are generated by drizzle-kit in packages/db
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // KV Namespace for session cache (optional, Better Auth uses DB by default)
  // "kv_namespaces": [
  //   {
  //     "binding": "SESSION_KV",
  //     "id": "YOUR_KV_NAMESPACE_ID"
  //   }
  // ],
  // Durable Objects for scheduled API calls
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "SchedulerDO"
      },
      {
        "name": "MONITOR_SCHEDULER",
        "class_name": "MonitorSchedulerDO"
      }
    ]
  },
  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SchedulerDO"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "MonitorSchedulerDO"
      ]
    }
  ],
  // Rate limiting for the public proxy and monitor checks
  // (period must be 10 or 60 seconds; namespace_id is any unique integer string)
  "unsafe": {
    "bindings": [
      {
        "name": "GUEST_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      },
      {
        "name": "USER_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 120, "period": 60 }
      }
    ]
  },
  // Environment variables (secrets go in `wrangler secret put` / .dev.vars)
  // APP_ENV defaults to production; `pnpm dev` overrides it with --var APP_ENV:development
  "vars": {
    "APP_ENV": "production",
    // Public web app origin — drives CORS and Better Auth trusted origins.
    // Extra origins (e.g. the *.pages.dev URL) can go in ALLOWED_ORIGINS, comma-separated.
    "NEXT_PUBLIC_APP_URL": "https://apiflow.redexoans.com",
    "ALLOWED_ORIGINS": "https://api-flow-web.pages.dev"
  },
  // Dev server config
  "dev": {
    "port": 8787
  }
}
