{
  "name": "api-flow",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @api-flow/db generate",
    "db:migrate": "pnpm --filter @api-flow/db migrate",
    "db:migrate:prod": "pnpm --filter @api-flow/db migrate:prod",
    "clean": "turbo clean && rm -rf node_modules",
    "deploy:api": "pnpm --filter @api-flow/api run deploy",
    "deploy:web": "pnpm --filter @api-flow/web run deploy",
    "deploy:all": "pnpm run db:migrate:prod && pnpm run deploy:api && pnpm run deploy:web"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
